# Sanity CMS Configuration
# Get your project ID from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: Only needed for server-side operations (write access)
# SANITY_API_TOKEN=your_api_token_here

# Email Configuration (SMTP)
# Use a service like Gmail, SendGrid, Resend, or Mailgun
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_or_api_key
CONTACT_EMAIL=where_to_receive_emails@example.com
